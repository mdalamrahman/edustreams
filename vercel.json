{
  "framework": "vite",
  "buildCommand": "cd admin-portal && npm run build",
  "outputDirectory": "admin-portal/dist",
  "rewrites": [
    {
      "source": "/api/gfg-potd",
      "destination": "/api/gfg-potd"
    },
    {
      "source": "/api/gfg/potd",
      "destination": "/api/gfg/potd"
    },
    {
      "source": "/api/potd/leetcode",
      "destination": "/api/potd/leetcode"
    },
    {
      "source": "/api/leetcode/potd",
      "destination": "/api/potd/leetcode"
    },
    {
      "source": "/api/leetcode/question",
      "destination": "/api/leetcode/question"
    },
    {
      "source": "/api/leetcode/verify-potd",
      "destination": "/api/leetcode/verify-potd"
    },
    {
      "source": "/api/leetcode/profile",
      "destination": "/api/leetcode/profile"
    },
    {
      "source": "/api/leetcode/full-profile/(.*)",
      "destination": "/api/leetcode/profile?username=$1"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/backend?path=/stream/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/backend?path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

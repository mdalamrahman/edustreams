{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/backend?path=/api/$1"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/backend?path=/stream/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

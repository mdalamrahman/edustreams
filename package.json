{
  "name": "private-edustream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build": "tsc && vite build && python scripts/copy_dist_assets.py",
    "build:student": "tsc && vite build && python scripts/copy_dist_assets.py",
    "build:admin": "cd admin-portal && npm run build",
    "preview": "vite preview",
    "deploy:student": "npm run build:student && npx wrangler pages deploy dist --project-name sdetube --branch main --commit-dirty=true",
    "deploy:admin": "cd admin-portal && npm run build && vercel --prod",
    "deploy:pages": "npm run deploy:student",
    "deploy:vercel": "npm run deploy:admin",
    "test:security": "python -m unittest discover -s tests -p \"test_*.py\""
  },
  "dependencies": {
    "@gradio/client": "^1.11.0",
    "@monaco-editor/react": "^4.6.0",
    "@supabase/supabase-js": "^2.39.8",
    "@upstash/redis": "^1.39.0",
    "@xyflow/react": "^12.12.0",
    "alasql": "^4.17.3",
    "canvas-confetti": "^1.9.2",
    "dompurify": "^3.4.18",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.14.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "input": "^1.0.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "telegram": "^2.26.22",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^6.4.6"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "image-size": "^2.1.0"
  }
}
